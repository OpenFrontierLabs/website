    "release": "wrangler deploy"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@tailwindcss/cli": "^4.3.5",
    "@types/bun": "^1.4.4",
    "oxlint": "^1.93.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.160.1"
  }
}
