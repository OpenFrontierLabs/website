{
  "name": "openfrontier-labs-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun scripts/build.ts && wrangler dev",
    "assets": "bun scripts/assets.ts",
    "typecheck": "OFL_GITHUB_FIXTURE=tests/fixtures/github.json bun scripts/build.ts && tsc --noEmit && tsc --noEmit -p worker",
    "lint": "oxlint scripts tests worker",
    "test": "bun test tests/site.test.ts tests/app.test.ts tests/swarm.test.ts",
    "check": "bun run typecheck && bun run lint && bun run test",
    "release": "bun run build && bun scripts/with-cf-deploy-token.ts -- sh -c 'wrangler d1 migrations apply ofl-waitlist --remote && wrangler deploy'",
    "migrate": "wrangler d1 migrations apply ofl-waitlist --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@tailwindcss/cli": "^4.3.5",
    "@types/bun": "^1.4.4",
    "oxlint": "^1.93.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.160.1"
  }
}
