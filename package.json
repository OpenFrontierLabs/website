{
  "name": "openfrontier-labs-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun scripts/serve.ts",
    "assets": "bun scripts/assets.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint scripts tests",
    "test": "bun test tests/site.test.ts",
